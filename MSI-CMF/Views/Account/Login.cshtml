@model MSI_CMF.Models.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — MSI CMF</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        html, body { margin: 0; height: 100%; font-family: 'Inter', system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
        body { display: flex; min-height: 100vh; }

        /* ── Brand panel (izquierda) ── */
        .l-brand {
            flex: 0 0 44%;
            background: linear-gradient(155deg, #08111d 0%, #0d2340 55%, #1a4480 100%);
            display: flex; flex-direction: column;
            justify-content: center; align-items: flex-start;
            padding: 60px 52px;
            position: relative; overflow: hidden;
        }
        .l-brand::before {
            content: '';
            position: absolute; inset: 0;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23fff' fill-opacity='.025'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/svg%3E");
        }
        .deco-blob {
            position: absolute; border-radius: 50%;
            background: radial-gradient(circle, rgba(37,99,235,.22) 0%, transparent 70%);
            width: 420px; height: 420px; bottom: -140px; right: -80px;
            pointer-events: none;
        }
        .deco-ring {
            position: absolute; border-radius: 50%;
            border: 1px solid rgba(255,255,255,.06);
            width: 260px; height: 260px; top: -60px; right: 10px;
        }
        .brand-logo {
            position: relative; z-index: 1;
            width: 54px; height: 54px; border-radius: 15px;
            background: rgba(255,255,255,.1);
            border: 1px solid rgba(255,255,255,.18);
            display: flex; align-items: center; justify-content: center;
            font-size: 1.4rem; color: #fff;
            margin-bottom: 28px;
            backdrop-filter: blur(4px);
        }
        .brand-title {
            position: relative; z-index: 1;
            font-size: 2.1rem; font-weight: 800; color: #fff;
            margin: 0 0 5px; letter-spacing: -.025em;
        }
        .brand-tagline {
            position: relative; z-index: 1;
            font-size: .9rem; color: #7ea8cc;
            margin: 0 0 36px;
        }
        .brand-features { list-style: none; padding: 0; margin: 0; position: relative; z-index: 1; }
        .brand-features li {
            display: flex; align-items: center; gap: 10px;
            color: #7ea8cc; font-size: .82rem; margin-bottom: 11px;
        }
        .brand-features li i { color: #3b82f6; width: 15px; }
        .brand-company {
            position: absolute; bottom: 26px; left: 52px;
            font-size: .7rem; color: #2d4a62;
            letter-spacing: .06em; text-transform: uppercase; z-index: 1;
        }

        /* ── Form panel (derecha) ── */
        .l-form {
            flex: 1; display: flex; align-items: center; justify-content: center;
            background: #f8fafc; padding: 40px 24px;
        }
        .form-box { width: 100%; max-width: 380px; }
        .form-box h1 { font-size: 1.45rem; font-weight: 700; color: #0f172a; margin: 0 0 4px; }
        .form-box .sub { font-size: .82rem; color: #64748b; margin: 0 0 28px; }

        .f-group { margin-bottom: 16px; }
        .f-group label { display: block; font-size: .77rem; font-weight: 600; color: #374151; margin-bottom: 5px; }
        .f-input { position: relative; }
        .f-input i { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); color: #9ca3af; font-size: .8rem; pointer-events: none; }
        .f-input input {
            width: 100%; padding: 9px 12px 9px 33px;
            border: 1.5px solid #e2e8f0; border-radius: 8px;
            font-size: .85rem; font-family: inherit; color: #0f172a;
            background: #fff; outline: none;
            transition: border-color .18s, box-shadow .18s;
        }
        .f-input input:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,.14); }
        .f-input input::placeholder { color: #c4cdd8; }
        .f-err { font-size: .72rem; color: #ef4444; margin-top: 3px; }

        .btn-login {
            width: 100%; padding: 10px; margin-top: 6px;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            color: #fff; border: none; border-radius: 8px;
            font-size: .88rem; font-weight: 600; font-family: inherit;
            cursor: pointer;
            box-shadow: 0 2px 8px rgba(37,99,235,.3);
            transition: all .18s;
        }
        .btn-login:hover { background: linear-gradient(135deg, #1d4ed8, #1e40af); box-shadow: 0 4px 14px rgba(37,99,235,.4); transform: translateY(-1px); }
        .btn-login:active { transform: translateY(0); }

        .btn-demo {
            display: flex; align-items: center; justify-content: center; gap: 7px;
            width: 100%; padding: 9px; margin-top: 8px;
            background: none; color: #d97706;
            border: 1.5px solid #fbbf24; border-radius: 8px;
            font-size: .81rem; font-weight: 600; font-family: inherit;
            cursor: pointer; transition: all .18s; text-decoration: none;
        }
        .btn-demo:hover { background: rgba(251,191,36,.08); color: #b45309; }

        .err-box {
            background: #fef2f2; border: 1px solid #fecaca;
            border-radius: 8px; padding: 10px 14px;
            margin-bottom: 18px; font-size: .8rem; color: #dc2626;
        }
        .login-foot { margin-top: 26px; text-align: center; font-size: .72rem; color: #94a3b8; }

        @@media (max-width: 767.98px) { .l-brand { display: none; } }
    </style>
</head>
<body>
    <!-- Panel izquierdo: branding -->
    <div class="l-brand">
        <div class="deco-blob"></div>
        <div class="deco-ring"></div>
        <div class="brand-logo"><i class="fa-solid fa-chart-line"></i></div>
        <h1 class="brand-title">MSI CMF</h1>
        <p class="brand-tagline">Plataforma de Reportería Regulatoria</p>
        <ul class="brand-features">
            <li><i class="fa-solid fa-circle-check"></i> Reportes FONDOS 03, 05 y 06</li>
            <li><i class="fa-solid fa-circle-check"></i> Mantenedor Costo de Inversión</li>
            <li><i class="fa-solid fa-circle-check"></i> Exportación a Excel</li>
            <li><i class="fa-solid fa-circle-check"></i> Control de acceso por roles</li>
        </ul>
        <span class="brand-company">&copy; @DateTime.Now.Year Volcom Capital</span>
    </div>

    <!-- Panel derecho: formulario -->
    <div class="l-form">
        <div class="form-box">
            <h1>Bienvenido</h1>
            <p class="sub">Ingresa tus credenciales para continuar</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="err-box">
                    <i class="fa-solid fa-circle-exclamation me-1"></i>
                    @Html.ValidationSummary(false)
                </div>
            }

            <form asp-controller="Account" asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                <div class="f-group">
                    <label for="usuario">Usuario</label>
                    <div class="f-input">
                        <i class="fa-regular fa-user"></i>
                        <input asp-for="usuario" id="usuario" placeholder="nombre de usuario" autocomplete="username" />
                    </div>
                    <div class="f-err"><span asp-validation-for="usuario"></span></div>
                </div>

                <div class="f-group">
                    <label for="password">Contraseña</label>
                    <div class="f-input">
                        <i class="fa-solid fa-lock"></i>
                        <input asp-for="password" id="password" type="password" placeholder="••••••••" autocomplete="current-password" />
                    </div>
                    <div class="f-err"><span asp-validation-for="password"></span></div>
                </div>

                <button type="submit" class="btn-login">
                    <i class="fa-solid fa-right-to-bracket me-1"></i>Ingresar
                </button>
            </form>

            @if (ViewBag.IsDevelopment == true)
            {
                <a asp-controller="Account" asp-action="LoginDemo" class="btn-demo">
                    <i class="fa-solid fa-flask"></i>Acceso Demo
                    <span style="opacity:.55;font-size:.7rem;font-weight:400">(solo desarrollo)</span>
                </a>
            }

            <div class="login-foot">
                MSI CMF &middot; Reportería Regulatoria CMF<br />
                <span style="color:#cbd5e1">Volcom Capital &copy; @DateTime.Now.Year</span>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>

