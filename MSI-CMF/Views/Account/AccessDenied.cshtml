@{
    ViewData["Title"] = "Acceso Denegado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-danger">
                <div class="card-body py-5">
                    <i class="fa-solid fa-ban fa-4x text-danger mb-4"></i>
                    <h2 class="fw-bold mb-2">Acceso Denegado</h2>
                    <p class="text-muted mb-4">
                        No tiene los permisos necesarios para acceder a esta sección.<br />
                        Contacte al administrador si cree que esto es un error.
                    </p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                        <i class="fa-solid fa-house me-1"></i>Volver al inicio
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
