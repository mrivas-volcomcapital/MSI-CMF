@model MSI_CMF.Models.CrearUsuarioRequest
@{
    ViewData["Title"] = "Crear Usuario";
}

<h2 class="mb-3"><i class="fa-solid fa-user-plus me-2"></i>Crear Usuario</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-check me-1"></i>@TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-controller="Account" asp-action="CrearUsuario" method="post">
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2">@Html.ValidationSummary(false)</div>
                    }

                    <div class="mb-3">
                        <label asp-for="usuario" class="form-label fw-semibold"></label>
                        <input asp-for="usuario" class="form-control" />
                        <span asp-validation-for="usuario" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="nombre" class="form-label fw-semibold"></label>
                        <input asp-for="nombre" class="form-control" />
                        <span asp-validation-for="nombre" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="email" class="form-label fw-semibold"></label>
                        <input asp-for="email" class="form-control" type="email" />
                        <span asp-validation-for="email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="password" class="form-label fw-semibold"></label>
                        <input asp-for="password" class="form-control" type="password" />
                        <span asp-validation-for="password" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="rol" class="form-label fw-semibold"></label>
                        <select asp-for="rol" class="form-select">
                            <option value="Admin">Admin</option>
                            <option value="Mantenedor">Mantenedor</option>
                            <option value="Usuario" selected>Usuario</option>
                        </select>
                        <span asp-validation-for="rol" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-floppy-disk me-1"></i>Crear usuario
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
