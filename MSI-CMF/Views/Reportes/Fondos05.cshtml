@model MSI_CMF.Models.Fondos05ViewModel
@{
    ViewData["Title"] = "FONDOS 05 — Activos, Cuotas y Partícipes";
}

<h2 class="mb-3"><i class="fa-solid fa-file-invoice me-2"></i>FONDOS 05 — Activos, Cuotas y Partícipes</h2>

<div class="card shadow-sm mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label fw-semibold mb-1">Fecha de consulta</label>
                <input type="date" id="fechaConsulta" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-auto">
                <button id="btnConsultar" class="btn btn-primary">
                    <i class="fa-solid fa-magnifying-glass me-1"></i>Consultar
                </button>
            </div>
            <div class="col-auto d-none" id="spinnerConsulta">
                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                <span class="ms-1 text-muted small">Consultando...</span>
            </div>
            <div class="col-auto ms-auto">
                <a id="btnExportar" class="btn btn-outline-success disabled" href="#" target="_blank">
                    <i class="fa-solid fa-file-excel me-1"></i>Exportar Excel
                </a>
            </div>
        </div>
        <div id="mensajeError" class="text-danger small mt-1 d-none"></div>
    </div>
</div>

<!-- R1: Activo/Pasivo -->
<div class="card shadow-sm mb-3">
    <div class="card-header bg-dark text-white py-2">
        <i class="fa-solid fa-circle-info me-1"></i>Registro 01 — Activo y Pasivo
    </div>
    <div class="card-body p-2">
        <div class="table-responsive">
            <table id="tablaR1" class="table table-striped table-bordered table-hover table-sm w-100">
                <thead class="table-dark">
                    <tr><th>Tipo Reg.</th><th>Fecha</th><th>Run Fondo</th><th>Total Activos</th><th>Total Pasivos</th></tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<!-- R2: Cuotas por serie -->
<div class="card shadow-sm mb-3">
    <div class="card-header bg-dark text-white py-2">
        <i class="fa-solid fa-circle-info me-1"></i>Registro 02 — Cuotas por serie
    </div>
    <div class="card-body p-2">
        <div class="table-responsive">
            <table id="tablaR2" class="table table-striped table-bordered table-hover table-sm w-100">
                <thead class="table-dark">
                    <tr><th>Tipo Reg.</th><th>Fecha</th><th>Run Fondo</th><th>Serie</th><th>Patrimonio</th><th>Cuotas Circ.</th><th>Valor Cuota</th><th>Aportes</th><th>Rescates</th></tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<!-- R3: Partícipes -->
<div class="card shadow-sm mb-3">
    <div class="card-header bg-dark text-white py-2">
        <i class="fa-solid fa-circle-info me-1"></i>Registro 03 — Partícipes por tipo
    </div>
    <div class="card-body p-2">
        <div class="table-responsive">
            <table id="tablaR3" class="table table-striped table-bordered table-hover table-sm w-100">
                <thead class="table-dark">
                    <tr><th>Tipo Reg.</th><th>Fecha</th><th>Run Fondo</th><th>Serie</th><th>Tipo Partícipe</th><th>Nº Partícipes</th><th>Proporción Patrimonio</th></tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const dtOpts = {
        destroy: true, responsive: true, pageLength: 25,
        language: { url: 'https://cdn.datatables.net/plug-ins/1.13.8/i18n/es-CL.json' }
    };
    function fmtNum(v) {
        if (v == null) return '';
        return parseFloat(v).toLocaleString('es-CL', { minimumFractionDigits: 2, maximumFractionDigits: 4 });
    }

    $('#btnConsultar').on('click', function () {
        const fecha = $('#fechaConsulta').val();
        if (!fecha) { $('#mensajeError').text('Seleccione una fecha.').removeClass('d-none'); return; }
        $('#mensajeError').addClass('d-none');
        $('#spinnerConsulta').removeClass('d-none');
        $('#btnConsultar').prop('disabled', true);

        $.getJSON('@Url.Action("GetFondos05Json", "Reportes")', { fecha })
            .done(function (res) {
                if (res.error) { $('#mensajeError').text(res.error).removeClass('d-none'); return; }

                $('#btnExportar').attr('href', '@Url.Action("ExportarExcel05", "Reportes")?fecha=' + fecha).removeClass('disabled');

                $('#tablaR1').DataTable({ ...dtOpts, data: res.registro1,
                    columns: [
                        { data: 'tipo_registro' }, { data: 'fecha_informacion' }, { data: 'run_fondo' },
                        { data: 'total_activos', render: fmtNum }, { data: 'total_pasivos', render: fmtNum }
                    ]
                });

                $('#tablaR2').DataTable({ ...dtOpts, data: res.registro2,
                    columns: [
                        { data: 'tipo_registro' }, { data: 'fecha_informacion' }, { data: 'run_fondo' },
                        { data: 'codigo_serie' },
                        { data: 'patrimonio',         render: fmtNum },
                        { data: 'cuotas_circulacion', render: fmtNum },
                        { data: 'valor_cuota',        render: fmtNum },
                        { data: 'aportes',            render: fmtNum },
                        { data: 'rescates',           render: fmtNum }
                    ]
                });

                $('#tablaR3').DataTable({ ...dtOpts, data: res.registro3,
                    columns: [
                        { data: 'tipo_registro' }, { data: 'fecha' }, { data: 'run_fondo' },
                        { data: 'codigo_serie' }, { data: 'tipo_participe' },
                        { data: 'numero_participes' },
                        { data: 'proporcion_patrimonio', render: fmtNum }
                    ]
                });
            })
            .fail(function () { $('#mensajeError').text('Error de comunicación con el servidor.').removeClass('d-none'); })
            .always(function () { $('#spinnerConsulta').addClass('d-none'); $('#btnConsultar').prop('disabled', false); });
    });
</script>
}
