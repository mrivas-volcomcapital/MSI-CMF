@model MSI_CMF.Models.Fondos06ViewModel
@{
    ViewData["Title"] = "FONDOS 06 — Partícipes por Sexo y Ubicación";
}

<h2 class="mb-3"><i class="fa-solid fa-file-invoice me-2"></i>FONDOS 06 — Partícipes por Sexo y Ubicación</h2>

<div class="card shadow-sm mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label fw-semibold mb-1">Fecha de consulta</label>
                <input type="date" id="fechaConsulta" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-auto">
                <button id="btnConsultar" class="btn btn-primary">
                    <i class="fa-solid fa-magnifying-glass me-1"></i>Consultar
                </button>
            </div>
            <div class="col-auto d-none" id="spinnerConsulta">
                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                <span class="ms-1 text-muted small">Consultando...</span>
            </div>
            <div class="col-auto ms-auto">
                <a id="btnExportar" class="btn btn-outline-success disabled" href="#" target="_blank">
                    <i class="fa-solid fa-file-excel me-1"></i>Exportar Excel
                </a>
            </div>
        </div>
        <div id="mensajeError" class="text-danger small mt-1 d-none"></div>
    </div>
</div>

<!-- R1: Por sexo -->
<div class="card shadow-sm mb-3">
    <div class="card-header bg-dark text-white py-2">
        <i class="fa-solid fa-circle-info me-1"></i>Registro 01 — Partícipes por sexo
    </div>
    <div class="card-body p-2">
        <div class="table-responsive">
            <table id="tablaR1" class="table table-striped table-bordered table-hover table-sm w-100">
                <thead class="table-dark">
                    <tr>
                        <th>Run Fondo</th><th>Serie</th><th>Sexo</th>
                        <th>Nº Partícipes</th><th>Proporción Patrimonio</th>
                        <th>Valor Cuota</th><th>Patrimonio Serie</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<!-- R2: Por ubicación -->
<div class="card shadow-sm mb-3">
    <div class="card-header bg-dark text-white py-2">
        <i class="fa-solid fa-circle-info me-1"></i>Registro 02 — Partícipes por ubicación (comuna/región)
    </div>
    <div class="card-body p-2">
        <div class="table-responsive">
            <table id="tablaR2" class="table table-striped table-bordered table-hover table-sm w-100">
                <thead class="table-dark">
                    <tr>
                        <th>Run Fondo</th><th>Serie</th><th>Comuna</th><th>Región</th>
                        <th>Nº Partícipes</th><th>Proporción Patrimonio</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const dtOpts = {
        destroy: true, responsive: true, pageLength: 25,
        language: { url: 'https://cdn.datatables.net/plug-ins/1.13.8/i18n/es-CL.json' }
    };
    function fmtNum(v) {
        if (v == null) return '';
        return parseFloat(v).toLocaleString('es-CL', { minimumFractionDigits: 2, maximumFractionDigits: 6 });
    }
    function fmtSexo(v) { return v === '01' ? 'Mujer' : v === '02' ? 'Hombre' : v; }

    $('#btnConsultar').on('click', function () {
        const fecha = $('#fechaConsulta').val();
        if (!fecha) { $('#mensajeError').text('Seleccione una fecha.').removeClass('d-none'); return; }
        $('#mensajeError').addClass('d-none');
        $('#spinnerConsulta').removeClass('d-none');
        $('#btnConsultar').prop('disabled', true);

        $.getJSON('@Url.Action("GetFondos06Json", "Reportes")', { fecha })
            .done(function (res) {
                if (res.error) { $('#mensajeError').text(res.error).removeClass('d-none'); return; }

                $('#btnExportar').attr('href', '@Url.Action("ExportarExcel06", "Reportes")?fecha=' + fecha).removeClass('disabled');

                $('#tablaR1').DataTable({ ...dtOpts, data: res.registro1,
                    columns: [
                        { data: 'run_fondo' }, { data: 'codigo_serie' },
                        { data: 'sexo', render: fmtSexo },
                        { data: 'numero_participes' },
                        { data: 'proporcion_patrimonio_serie', render: fmtNum },
                        { data: 'valor_cuota',                render: fmtNum },
                        { data: 'patrimonio_serie',           render: fmtNum }
                    ]
                });

                $('#tablaR2').DataTable({ ...dtOpts, data: res.registro2,
                    columns: [
                        { data: 'run_fondo' }, { data: 'codigo_serie' },
                        { data: 'comuna' }, { data: 'region' },
                        { data: 'numero_participes' },
                        { data: 'proporcion_patrimonio_serie', render: fmtNum }
                    ]
                });
            })
            .fail(function () { $('#mensajeError').text('Error de comunicación con el servidor.').removeClass('d-none'); })
            .always(function () { $('#spinnerConsulta').addClass('d-none'); $('#btnConsultar').prop('disabled', false); });
    });
</script>
}
