@model List<MSI_CMF.Models.CostoInversionModel>
@{
    ViewData["Title"] = "Costo Inversión en Otros Vehículos";
}

<h2 class="mb-3"><i class="fa-solid fa-coins me-2"></i>Costo Inversión en Otros Vehículos</h2>

<!-- Filtros -->
<div class="card shadow-sm mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label fw-semibold mb-1">Año</label>
                <input type="number" id="filtroAnio" class="form-control" style="width:100px"
                       value="@ViewBag.AnioActual" min="2000" max="2100" />
            </div>
            <div class="col-auto">
                <button id="btnFiltrar" class="btn btn-primary">
                    <i class="fa-solid fa-filter me-1"></i>Filtrar
                </button>
            </div>
            <div class="col-auto ms-auto">
                <!-- Import Excel -->
                <label class="btn btn-outline-success mb-0 me-1" for="inputExcel">
                    <i class="fa-solid fa-file-excel me-1"></i>Importar Excel
                </label>
                <input type="file" id="inputExcel" accept=".xlsx" class="d-none" />
                <!-- Nuevo -->
                <button class="btn btn-success" id="btnNuevo">
                    <i class="fa-solid fa-plus me-1"></i>Nuevo
                </button>
            </div>
        </div>
        <div id="mensajeImport" class="mt-2 d-none"></div>
    </div>
</div>

<!-- Grilla -->
<div class="card shadow-sm">
    <div class="card-body p-2">
        <div class="table-responsive">
            <table id="tablaMantenedor" class="table table-striped table-bordered table-hover table-sm w-100">
                <thead class="table-dark">
                    <tr>
                        <th>Run Fondo</th><th>DV</th><th>Nombre Fondo</th>
                        <th>Período</th><th>Año</th>
                        <th>Costo Master Fund</th><th>Costo Fondos Mutuo</th>
                        <th>Horizonte</th><th>Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal ABM -->
<div class="modal fade" id="modalForm" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="modalLabel"><i class="fa-solid fa-coins me-1"></i>Registro</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="modalError" class="alert alert-danger d-none"></div>
                <div class="row g-2">
                    <div class="col-8">
                        <label class="form-label">Run Fondo <span class="text-danger">*</span></label>
                        <input type="text" id="fRunFondo" class="form-control" maxlength="10" />
                    </div>
                    <div class="col-4">
                        <label class="form-label">DV</label>
                        <input type="text" id="fDvFondo" class="form-control" maxlength="1" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Nombre Fondo <span class="text-danger">*</span></label>
                        <input type="text" id="fNombreFondo" class="form-control" maxlength="200" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Período <span class="text-danger">*</span></label>
                        <select id="fPeriodo" class="form-select">
                            @for (int m = 1; m <= 12; m++)
                            {
                                <option value="@m">@m</option>
                            }
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Año <span class="text-danger">*</span></label>
                        <input type="number" id="fAnio" class="form-control" min="2000" max="2100" value="@ViewBag.AnioActual" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Costo Master Fund</label>
                        <input type="text" id="fCostoMaster" class="form-control" maxlength="20" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Costo Fondos Mutuo</label>
                        <input type="text" id="fCostoFondos" class="form-control" maxlength="20" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Horizonte Tiempo (cód.)</label>
                        <input type="text" id="fHorizonte" class="form-control" maxlength="2" placeholder="3 ó 5" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnGuardar">
                    <i class="fa-solid fa-floppy-disk me-1"></i>Guardar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let tabla;
    const modal = new bootstrap.Modal(document.getElementById('modalForm'));

    const dtOpts = {
        pageLength: 50, responsive: true,
        language: { url: 'https://cdn.datatables.net/plug-ins/1.13.8/i18n/es-CL.json' }
    };

    function cargarTabla() {
        const anio = $('#filtroAnio').val() || '';
        if (tabla) tabla.destroy();
        $.getJSON('@Url.Action("GetJson", "CostoInversion")', { anio: anio || null })
            .done(function (res) {
                tabla = $('#tablaMantenedor').DataTable({ ...dtOpts, data: res.data,
                    columns: [
                        { data: 'run_fondo' },
                        { data: 'dv_fondo',    defaultContent: '' },
                        { data: 'nombre_fondo' },
                        { data: 'periodo' },
                        { data: 'anio' },
                        { data: 'costo_inversion_master_fund',  defaultContent: '' },
                        { data: 'costo_inversion_fondos_mutuo', defaultContent: '' },
                        { data: 'horizonte_tiempo_codigo',      defaultContent: '' },
                        {
                            data: null, orderable: false,
                            render: function (data) {
                                return `<button class="btn btn-sm btn-outline-primary btn-editar me-1"
                                            data-run="${data.run_fondo}" data-dv="${data.dv_fondo ?? ''}"
                                            data-nombre="${data.nombre_fondo}" data-periodo="${data.periodo}"
                                            data-anio="${data.anio}"
                                            data-master="${data.costo_inversion_master_fund ?? ''}"
                                            data-fondos="${data.costo_inversion_fondos_mutuo ?? ''}"
                                            data-horizonte="${data.horizonte_tiempo_codigo ?? ''}">
                                            <i class="fa-solid fa-pen-to-square"></i></button>
                                        <button class="btn btn-sm btn-outline-danger btn-eliminar"
                                            data-run="${data.run_fondo}" data-periodo="${data.periodo}" data-anio="${data.anio}">
                                            <i class="fa-solid fa-trash"></i></button>`;
                            }
                        }
                    ]
                });
            });
    }

    $('#btnFiltrar').on('click', cargarTabla);
    cargarTabla();

    // Nuevo
    $('#btnNuevo').on('click', function () {
        $('#fRunFondo,#fDvFondo,#fNombreFondo,#fCostoMaster,#fCostoFondos,#fHorizonte').val('');
        $('#fPeriodo').val(new Date().getMonth() + 1);
        $('#fAnio').val($('#filtroAnio').val());
        $('#modalError').addClass('d-none');
        modal.show();
    });

    // Editar
    $(document).on('click', '.btn-editar', function () {
        const d = $(this).data();
        $('#fRunFondo').val(d.run); $('#fDvFondo').val(d.dv);
        $('#fNombreFondo').val(d.nombre); $('#fPeriodo').val(d.periodo);
        $('#fAnio').val(d.anio); $('#fCostoMaster').val(d.master);
        $('#fCostoFondos').val(d.fondos); $('#fHorizonte').val(d.horizonte);
        $('#modalError').addClass('d-none');
        modal.show();
    });

    // Guardar
    $('#btnGuardar').on('click', function () {
        const payload = {
            run_fondo:    $('#fRunFondo').val().trim(),
            dv_fondo:     $('#fDvFondo').val().trim() || null,
            nombre_fondo: $('#fNombreFondo').val().trim(),
            periodo:      parseInt($('#fPeriodo').val()),
            anio:         parseInt($('#fAnio').val()),
            costo_inversion_master_fund:  $('#fCostoMaster').val().trim() || null,
            costo_inversion_fondos_mutuo: $('#fCostoFondos').val().trim() || null,
            horizonte_tiempo_codigo:      $('#fHorizonte').val().trim() || null
        };
        if (!payload.run_fondo || !payload.nombre_fondo) {
            $('#modalError').text('Run fondo y nombre son obligatorios.').removeClass('d-none'); return;
        }
        $.ajax({
            url: '@Url.Action("Guardar", "CostoInversion")',
            type: 'POST', contentType: 'application/json',
            data: JSON.stringify(payload),
            headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() }
        }).done(function (res) {
            if (res.error) { $('#modalError').text(res.error).removeClass('d-none'); return; }
            modal.hide(); cargarTabla();
        }).fail(function () { $('#modalError').text('Error al guardar.').removeClass('d-none'); });
    });

    // Eliminar
    $(document).on('click', '.btn-eliminar', function () {
        const d = $(this).data();
        if (!confirm(`¿Eliminar run_fondo=${d.run} período=${d.periodo} año=${d.anio}?`)) return;
        $.post('@Url.Action("Eliminar", "CostoInversion")',
            { runFondo: d.run, periodo: d.periodo, anio: d.anio,
              __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() })
            .done(function (res) { if (!res.error) cargarTabla(); else alert(res.error); });
    });

    // Importar Excel
    $('#inputExcel').on('change', function () {
        const file = this.files[0];
        if (!file) return;
        const fd = new FormData();
        fd.append('archivo', file);
        fd.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').val());
        $('#mensajeImport').removeClass('d-none alert-success alert-danger').text('Procesando...').addClass('alert alert-info');
        $.ajax({
            url: '@Url.Action("ImportarExcel", "CostoInversion")',
            type: 'POST', data: fd, contentType: false, processData: false
        }).done(function (res) {
            if (res.error) {
                const det = res.detalle ? '<br>' + res.detalle.join('<br>') : '';
                $('#mensajeImport').removeClass('alert-info').addClass('alert-danger')
                    .html('<i class="fa-solid fa-triangle-exclamation me-1"></i>' + res.error + det);
            } else {
                $('#mensajeImport').removeClass('alert-info').addClass('alert-success')
                    .html('<i class="fa-solid fa-circle-check me-1"></i>' + res.procesados + ' registros importados correctamente.');
                cargarTabla();
            }
        }).fail(function () {
            $('#mensajeImport').removeClass('alert-info').addClass('alert-danger').text('Error al importar.');
        });
        $(this).val('');
    });
</script>
}

@Html.AntiForgeryToken()
